# Full RPC endpoint including any provider key, e.g. https://mainnet.helius-rpc.com/?api-key=...
# Empty falls back to the public mainnet RPC (slow, dev only).
RPC_URL=

# Optional, defaults shown. Raise RPC_RPS / RPC_CONCURRENCY to match your RPC plan.
# RPC_RPS=8
# RPC_CONCURRENCY=4
# CACHE_DIR=.cache
# PORT=3000
# PUBLIC_URL=https://your.domain   (share-card URLs; default: the request's host)

# Optional: keep the cache in Cloudflare R2 (or any S3-compatible bucket) instead of CACHE_DIR,
# so it survives deploys without a disk. Setting S3_BUCKET turns it on.
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CACHE_PREFIX=dtp-history/cache/
